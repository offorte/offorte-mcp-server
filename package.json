{
	"name": "@offorte/mcp-server",
	"version": "0.1.2",
	"repository": {
		"url": "git+https://github.com/offorte/offorte-mcp-server.git"
	},
	"description": "Offorte MCP Server",
	"author": "Offorte",
	"homepage": "https://www.offorte.com",
	"license": "MIT",
	"type": "module",
	"main": "dist/server.js",
	"bin": {
		"offorte-mcp-server": "./dist/server.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsup && chmod 755 dist/server.js",
		"dev": "mcp-inspector --tui -- tsx src/server.ts",
		"format": "prettier --write . && eslint --fix .",
		"inspect": "CLIENT_PORT=8001 mcp-inspector -- tsx src/server.ts",
		"lint": "prettier --check . && eslint . && tsc --noEmit",
		"prepublishOnly": "npm run build",
		"start": "node dist/server.js",
		"test": "pnpm build && vitest run"
	},
	"dependencies": {
		"@hono/node-server": "2.1.8",
		"@modelcontextprotocol/hono": "2.0.2",
		"@modelcontextprotocol/server": "2.4.0",
		"axios": "1.9.0",
		"dotenv": "16.5.0",
		"hono": "4.13.19",
		"outdent": "0.8.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "9.26.0",
		"@modelcontextprotocol/client": "2.4.0",
		"@modelcontextprotocol/inspector": "2.15.0",
		"@tsconfig/node24": "24.0.3",
		"@types/node": "24.19.2",
		"chalk": "5.4.1",
		"eslint": "9.26.0",
		"eslint-config-prettier": "10.1.5",
		"eslint-plugin-perfectionist": "4.13.0",
		"jiti": "2.4.2",
		"prettier": "3.5.3",
		"semantic-release": "24.2.3",
		"tsup": "8.4.0",
		"tsx": "4.19.4",
		"typescript": "5.8.3",
		"typescript-eslint": "8.32.1",
		"vitest": "5.1.0"
	},
	"tsup": {
		"entry": [
			"src/server.ts"
		],
		"format": [
			"esm"
		],
		"dts": true,
		"splitting": true,
		"sourcemap": true,
		"clean": true,
		"banner": {
			"js": "#!/usr/bin/env node"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"release": {
		"repositoryUrl": "https://github.com/offorte/offorte-mcp-server.git",
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/npm",
			"@semantic-release/github"
		]
	},
	"keywords": [
		"offorte",
		"mcp",
		"server",
		"proposals",
		"proposal software",
		"sales automation",
		"sales",
		"automation",
		"offorte mcp server",
		"mcp server"
	],
	"packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
